{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "englishy",
  "main": "deploy/embedded-worker.ts",
  "compatibility_date": "2026-11-19",
  // Live Domains & Routes settings: the workers.dev URL and preview URLs are both on. Stated here so a deploy
  // from this file keeps them as they are.
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  // Set the production secret separately with `wrangler secret put NVIDIA_API_KEY`.
  "vars": {
    "AI_ENABLED": "true",
    "AI_DAILY_GLOBAL_LIMIT": "3000",
    "AI_DAILY_LIMIT_PER_CLIENT": "150",
    "AI_MAX_OUTPUT_TOKENS": "2400",
    "AI_TIMEOUT_MS": "45000",
    "ALLOWED_ORIGINS": "",
    "NVIDIA_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "NVIDIA_MODEL": "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "NVIDIA_MODEL_CONVERSATION": "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "NVIDIA_MODEL_STRUCTURED": "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "NVIDIA_MODEL_TUTOR": "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "NVIDIA_MODEL_FAST": "nvidia/nemotron-3.5-lightning-30b-a3b"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
