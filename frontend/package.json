    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
